<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:Acl/etc/acl.xsd">
    <acl>
        <resources>
            <resource id="Magento_Backend::admin">
                <resource id="Magento_Backend::stores">
                    <resource id="Magento_Backend::stores_settings">
                        <resource id="Magento_Config::config">
                            <resource id="Phong_ApiLogger::logger" title="Menu Api Logger" sortOrder="50" />
                            <resource id="Phong_ApiLogger::config_logger" title="Config Rest Api Logger" sortOrder="50" />
                            <resource id="Phong_ApiLogger::rest_logger" title="Rest Api Logger" sortOrder="50" />
                        </resource>
                    </resource>
                </resource>
            </resource>
        </resources>
    </acl>
</config>
