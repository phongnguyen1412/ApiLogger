<?xml version="1.0" ?>
<listing xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Ui:etc/ui_configuration.xsd">
    <argument name="data" xsi:type="array">
        <item name="js_config" xsi:type="array">
            <item name="provider" xsi:type="string">phong_apilogger_logger_listing.phong_apilogger_logger_grid_data_source</item>
            <item name="deps" xsi:type="string">phong_apilogger_logger_listing.phong_apilogger_logger_grid_data_source</item>
        </item>
        <item name="spinner" xsi:type="string">logger_columns</item>
        <item name="buttons" xsi:type="array">
            <item name="delete" xsi:type="array">
                <item name="name" xsi:type="string">delete</item>
                <item name="label" xsi:type="string" translate="true">Purge Activity Logs</item>
                <item name="class" xsi:type="string">primary</item>
                <item name="url" xsi:type="url" path="Phong_ApiLogger/logger/massDelete"/>
            </item>
        </item>
    </argument>
    <dataSource name="phong_apilogger_logger_grid_data_source">
        <argument name="dataProvider" xsi:type="configurableObject">
            <argument name="class" xsi:type="string">Phong\ApiLogger\Ui\Component\DataProvider</argument>
            <argument name="name" xsi:type="string">phong_apilogger_logger_grid_data_source</argument>
            <argument name="primaryFieldName" xsi:type="string">id</argument>
            <argument name="requestFieldName" xsi:type="string">id</argument>
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Magento_Ui/js/grid/provider</item>
                    <item name="update_url" xsi:type="url" path="mui/index/render"/>
                    <item name="storageConfig" xsi:type="array">
                        <item name="indexField" xsi:type="string">id</item>
                    </item>
                </item>
            </argument>
        </argument>
    </dataSource>
    <listingToolbar name="listing_top">
        <columnsControls name="columns_controls"/>
        <filters name="listing_filters"/>
        <paging name="listing_paging"/>
    </listingToolbar>
    <columns name="logger_columns">
        <selectionsColumn name="ids">
            <settings>
                <indexField>id</indexField>
            </settings>
        </selectionsColumn>
        <column name="id">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">textRange</item>
                    <item name="label" translate="true" xsi:type="string">ID</item>
                    <item name="sorting" xsi:type="string">desc</item>
                </item>
            </argument>
        </column>
        <column name="method_rest">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" translate="true" xsi:type="string">Method</item>
                </item>
            </argument>
        </column>
        <column name="path_action">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" translate="true" xsi:type="string">Path Action</item>
                </item>
            </argument>
        </column>
        <column name="input_data">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" translate="true" xsi:type="string">Input Data</item>
                    <item name="component" xsi:type="string">Phong_ApiLogger/js/grid/collapsible-text</item>
                </item>
            </argument>
        </column>
        <column name="status">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" translate="true" xsi:type="string">Status</item>
                    <item name="component" xsi:type="string">Phong_ApiLogger/js/grid/status-color</item>
                </item>
            </argument>
        </column>
        <column name="output_response">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="component" xsi:type="string">Phong_ApiLogger/js/grid/collapsible-text</item>
                    <item name="filter" xsi:type="string">text</item>
                    <item name="label" translate="true" xsi:type="string">Output</item>
                </item>
            </argument>
        </column>
        <column name="created_at">
            <argument name="data" xsi:type="array">
                <item name="config" xsi:type="array">
                    <item name="filter" xsi:type="string">dateRange</item>
                    <item name="label" translate="true" xsi:type="string">Created At</item>
                </item>
            </argument>
        </column>
    </columns>
</listing>
